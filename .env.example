# BigQuery project and dataset this repo writes to (dbt target + Python reads)
NFLM_GCP_PROJECT=gen-lang-client-0525946386
NFLM_DATASET=nflm_dev
# dbt target for `nflm refresh`: dev on laptops, prod on the VM (dataset nflm)
NFLM_DBT_TARGET=dev
# sports_db project and staging dataset (read only)
SPORTS_DB_PROJECT=sports-db-209650
SPORTS_DB_STAGING=dev_staging
# fantasy-football-draft-helper marts (read only, Sleeper projections benchmark)
FF_PROJECT=gen-lang-client-0525946386
FF_MARTS=ff_marts
# Your Sleeper league (public, no auth)
SLEEPER_LEAGUE_ID=
SLEEPER_USERNAME=
# Discord alerts and lineup posts: a webhook URL, or a Secret Manager secret version holding one
NFLM_ALERT_WEBHOOK_URL=
NFLM_ALERT_SECRET=
